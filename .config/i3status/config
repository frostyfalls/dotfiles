general {
	interval = 10
}

order += "volume master"
order += "read_file weather"
order += "disk /home"
order += "load"
order += "memory"
order += "time"

read_file "weather" {
	path = "/home/user/.cache/weather"
	color_good = ""
}

volume "master" {
	format = "vol:%volume"
	format_muted = "vol:mute"
}

disk "/home" {
	format = "home:%avail"
}

load {
	format = "%1min"
}

memory {
	format = "mem:%used"
}

time {
	format = "%Y-%m-%d %H:%M"
}
